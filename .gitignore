## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/
.vscode/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Microsoft Azure
*.pubxml
*.azurePubxml

# Database
*.mdf
*.ldf
*.ndf

# Others
*.log
*.cache
*.tmp
*.bak
*.swp
*~
